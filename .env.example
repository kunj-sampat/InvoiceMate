# =========================================================================
# InvoiceMate - Environment Configuration Template
# Duplicate this file as .env and fill in your confidential values.
# DO NOT COMMIT .env TO VERSION CONTROL.
# =========================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_256_bits_long_for_security
JWT_EXPIRATION_MS=86400000

# Database Configuration (Development default: embedded H2)
# For MySQL production:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=invoicemate
# DB_USERNAME=root
# DB_PASSWORD=your_password

# =========================================================================
# FUTURE AI & INTELLIGENCE SERVICES (Optional / Planned)
# =========================================================================

